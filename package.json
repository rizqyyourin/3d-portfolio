    "sync": "bun run freecodecamp:sync && bun run github:sync",
    "freecodecamp:sync": "node scripts/fetch-freecodecamp.mjs",
    "github:sync": "node scripts/fetch-github.mjs",
    "lint": "eslint .",
    "test": "playwright test"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.15.1",
