{
  "name": "web-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "unrs-resolver",
    "esbuild",
    "workerd"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "bun run sync && next build",
    "start": "next start",
    "preview": "wrangler dev",
